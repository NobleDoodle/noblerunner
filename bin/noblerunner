#!/bin/bash

set -uo pipefail

PLUGIN_ID="nobledoodle.noblerunner"
IPC_TARGET="noblerunner"
# The name before 2026-11-01; install, setup and doctor clean up after it.
LEGACY_ID="typecraft.omacast"
LEGACY_NAME="omacast"

self=$(readlink -f "${BASH_SOURCE[0]}")
repo=$(cd "$(dirname "$self")/.." && pwd -P)
plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
plugin_link="$plugins_dir/$PLUGIN_ID"
hypr_dir="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
cli_link="$HOME/.local/bin/noblerunner"

# A marketplace install (`omarchy plugin add`) is this repo cloned straight into
# the plugins dir. A development checkout lives elsewhere and is symlinked in.
managed() { [[ $repo == "$(cd "$plugins_dir" 2>/dev/null && pwd -P)/$PLUGIN_ID" ]]; }

installed_links() {
  local link
  for link in "$plugin_link" "$plugin_link".dev-*; do
    [[ -L $link && $(readlink -f "$link") == "$repo" ]] && printf '%s\n' "$link"
  done
}

current_link() { installed_links | tail -n1; }

usage() {
  cat <<USAGE
Usage: noblerunner <command> [args]

Launcher
  toggle                 Show or hide the launcher
  show | hide            Show or hide it
  run <commandId>        Open a command directly
  call <method> [json]   Call a backend method, e.g. noblerunner call system.info

Setup
  install                Enable the plugin and link this CLI into ~/.local/bin
                         (a development checkout is also linked into omarchy-shell)
  uninstall              Disable and remove the plugin, offering to remove the hotkey
  setup hyprland         Choose the hotkey (Alt+Space, Super, Super+Space or Off);
                         it goes in ~/.config/hypr/noblerunner.lua
      [--key=alt-space|super|super-space|off] [--yes]   the same without questions
  build-search           Build the optional flea-search helper (needs Rust/cargo)
  doctor                 Check that the pieces are in place

Development checkout
  reload                 Make the shell reload the plugin after editing it
  dev                    Reload the plugin on every save
USAGE
}

die() { echo "noblerunner: $*" >&2; exit 1; }

ipc() { omarchy-shell "$IPC_TARGET" "$@"; }

need_shell() {
  command -v omarchy-shell >/dev/null || die "omarchy-shell not found; noblerunner runs inside the Omarchy shell"
}

interactive() { [[ -t 0 && -t 1 ]]; }

# confirm <prompt> <assume-yes>
confirm() {
  (( $2 )) && return 0
  interactive || die "refusing to change your config without confirmation; pass --yes"
  if command -v gum >/dev/null; then
    gum confirm "$1"
  else
    local answer
    read -r -p "$1 [y/N] " answer
    [[ $answer == [yY]* ]]
  fi
}

link_cli() {
  mkdir -p "$HOME/.local/bin"
  if [[ ! -e $cli_link || -L $cli_link ]]; then
    ln -sfn "$self" "$cli_link"
    echo "linked $cli_link"
  else
    echo "left $cli_link alone; it is not a symlink"
  fi
}

# Undo what the omacast install left behind: its plugin links, its enable
# entry and its CLI link. Hyprland files are handled by setup hyprland.
remove_legacy_install() {
  local link removed=0
  for link in "$plugins_dir/$LEGACY_ID" "$plugins_dir/$LEGACY_ID".dev-*; do
    [[ -L $link ]] || continue
    rm "$link" && echo "removed old link $link" && removed=1
  done
  if omarchy plugin list --json 2>/dev/null | jq -e --arg id "$LEGACY_ID" 'any(.[]; .id == $id and .enabled)' >/dev/null 2>&1 ||
    jq -e --arg id "$LEGACY_ID" '.plugins // [] | any(.id == $id)' "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json" >/dev/null 2>&1; then
    omarchy plugin disable "$LEGACY_ID" >/dev/null 2>&1 && echo "disabled $LEGACY_ID"
  fi
  local old_cli="$HOME/.local/bin/$LEGACY_NAME"
  if [[ -L $old_cli && ( ! -e $old_cli || $(readlink "$old_cli") == "$repo"/* ) ]]; then
    rm "$old_cli" && echo "removed old $old_cli"
  fi
  (( removed )) && omarchy-shell -q shell rescanPlugins
  return 0
}

# Same rule as core/Paths.js legacyMoves, run before build-search creates the
# new cache dir and so stops the plugin from moving the old one.
move_legacy_dirs() {
  local base
  for base in "${XDG_CONFIG_HOME:-$HOME/.config}" "${XDG_DATA_HOME:-$HOME/.local/share}" \
    "${XDG_CACHE_HOME:-$HOME/.cache}" "${XDG_STATE_HOME:-$HOME/.local/state}"; do
    [[ -d $base/$LEGACY_NAME && ! -e $base/noblerunner ]] || continue
    mv -T -- "$base/$LEGACY_NAME" "$base/noblerunner" && echo "moved $base/$LEGACY_NAME to $base/noblerunner"
  done
}

cmd_install() {
  need_shell
  [[ -f $repo/manifest.json ]] || die "plugin manifest missing at $repo"
  move_legacy_dirs
  if command -v cargo >/dev/null; then
    "$repo/bin/build-search" || die "search helper build failed; plugin was not installed"
  else
    echo "Rust not found; skipping the helper build (using an existing helper or the built-in matcher)"
  fi
  remove_legacy_install

  if ! managed; then
    mkdir -p "$plugins_dir"
    if [[ -e $plugin_link && ! -L $plugin_link ]]; then
      die "$plugin_link exists and is not a symlink; remove it with: omarchy plugin remove $PLUGIN_ID"
    fi
    ln -sfn "$repo" "$plugin_link"
    echo "linked $plugin_link -> $repo"
  fi
  link_cli

  omarchy-shell -q shell rescanPlugins
  local out i
  for i in $(seq 1 50); do
    out=$(omarchy plugin enable "$PLUGIN_ID" 2>&1) && break
    [[ $out == *"not ready"* || $out == *"could not find"* || $out == *"not known"* ]] || break
    sleep 0.1
  done
  [[ -n $out ]] && echo "$out"

  for i in $(seq 1 100); do
    if [[ $(omarchy-shell "$IPC_TARGET" ping 2>/dev/null) == "ok" ]]; then
      echo "noblerunner is running"
      [[ -f $hypr_dir/noblerunner.lua ]] || echo "bind a hotkey with: noblerunner setup hyprland"
      return 0
    fi
    sleep 0.1
  done
  die "plugin did not answer; check the shell log with: qs log -n -p \"\$OMARCHY_PATH/shell\""
}

cmd_uninstall() {
  need_shell
  local assume_yes=0
  [[ ${1:-} == --yes || ${1:-} == -y ]] && assume_yes=1

  if [[ -L $cli_link && $(readlink -f "$cli_link") == "$self" ]]; then
    rm "$cli_link" && echo "removed $cli_link"
  fi
  if [[ -f $hypr_dir/noblerunner.lua ]]; then
    if ! (( assume_yes )) && ! interactive; then
      echo "kept the hotkey; remove $hypr_dir/noblerunner.lua and require(\"hypr.noblerunner\") yourself, or pass --yes"
    elif confirm "Remove the hotkey ($hypr_dir/noblerunner.lua and its require in hyprland.lua)?" "$assume_yes"; then
      sed -i -E '/^\s*require\("hypr\.noblerunner"\)\s*$/d; /^-- noblerunner launcher bindings$/d' "$hypr_dir/hyprland.lua"
      rm "$hypr_dir/noblerunner.lua" && echo "removed $hypr_dir/noblerunner.lua"
      hyprctl reload >/dev/null 2>&1
    fi
  fi

  if managed; then
    local args=()
    (( assume_yes )) && args=(--yes)
    exec omarchy plugin remove "$PLUGIN_ID" "${args[@]}"
  fi
  omarchy plugin disable "$PLUGIN_ID" 2>/dev/null || true
  local link
  while IFS= read -r link; do
    [[ -n $link ]] && rm "$link" && echo "removed $link"
  done < <(installed_links)
  omarchy-shell -q shell rescanPlugins
}

need_checkout() {
  managed && die "$1 is for development checkouts; edits under $repo reload automatically"
  [[ -n $(current_link) ]] || die "plugin is not installed; run: noblerunner install"
}

cmd_reload() {
  need_checkout reload
  local old
  while IFS= read -r old; do rm "$old"; done < <(installed_links)
  ln -s "$repo" "$plugin_link.dev-$(date +%s%N)"
}

cmd_dev() {
  command -v inotifywait >/dev/null || die "inotifywait not found (inotify-tools)"
  need_checkout dev
  cmd_reload
  echo "watching $repo; Ctrl+C to stop"
  inotifywait -m -r -q -e close_write,create,delete,move --format '%w%f' \
    --exclude '/(\.git|search|tests|reference|docs)/' "$repo" |
    while read -r path; do
      echo "changed ${path#"$repo"/}"
      cmd_reload
    done
}

# --- Hotkey setup -----------------------------------------------------------
# Four choices. Each one owns its chord: the file unbinds whatever held it and
# then binds the launcher, and it loads last, after the user's own bindings.
HOTKEY_KEYS=(alt-space super super-space off)
HOTKEY_MARK='-- Written by `noblerunner setup hyprland`'

hotkey_label() {
  case $1 in
    alt-space) echo "Alt+Space" ;;
    super) echo "Super" ;;
    super-space) echo "Super+Space" ;;
    off) echo "Off" ;;
  esac
}

hotkey_note() {
  case $1 in
    alt-space) echo "the usual launcher key" ;;
    super) echo "tap the Super key by itself; holding it for another shortcut does nothing" ;;
    super-space) echo "takes the Omarchy menu's key; the menu stays in noblerunner as \"Omarchy Menu\"" ;;
    off) echo "no hotkey; open it with: noblerunner toggle" ;;
  esac
}

# What the running Hyprland has on a choice's chord, other than the launcher.
# Asking Hyprland is exact: Omarchy binds some keys only when a program is
# installed, which a search of the config files cannot tell.
hotkey_holder() {
  local mask key release
  case $1 in
    alt-space) mask=8 key=SPACE release=false ;;
    super) mask=64 key=SUPER_L release=true ;;
    super-space) mask=64 key=SPACE release=false ;;
    *) return 0 ;;
  esac
  hyprctl binds -j 2>/dev/null | jq -r --argjson mask "$mask" --arg key "$key" --argjson release "$release" '
    [.[] | select(.modmask == $mask and (.key | ascii_upcase) == $key and .release == $release)
         | select((.description // "") != "noblerunner launcher")
         | (.description // "" | if . == "" then "another bind" else . end)] | unique | join(", ")' 2>/dev/null
}

hotkey_lua() {
  printf '%s (key: %s). Safe to edit; setup backs it up before replacing it.\n' "$HOTKEY_MARK" "$1"
  case $1 in
    alt-space) cat <<'LUA'
-- Alt+Space reaches the plugin's global shortcut directly, so no process
-- starts per keypress. Omarchy puts dictation on Alt+Space when a dictation
-- program is installed; the unbind gives the key to the launcher.
hl.unbind("ALT + SPACE")
o.bind("ALT + SPACE", "noblerunner launcher", hl.dsp.global("noblerunner:toggle"))
LUA
      ;;
    super) cat <<'LUA'
-- A tap of left Super toggles the launcher. The chord is SUPER + SUPER_L:
-- on release the Super modifier is still down, so a bare Super_L bind does
-- not match. It fires on release, so holding Super for another shortcut
-- does not open the launcher. This one runs the command: dispatching the
-- global shortcut from inside this bind reports success and opens nothing.
hl.unbind("SUPER + SUPER_L")
o.bind("SUPER + SUPER_L", "noblerunner launcher", "'" .. os.getenv("HOME") .. "/.local/bin/noblerunner' toggle", { release = true })
LUA
      ;;
    super-space) cat <<'LUA'
-- Super+Space is the Omarchy menu's key. The unbind hands it to the
-- launcher; the menu is still there in noblerunner as "Omarchy Menu".
hl.unbind("SUPER + SPACE")
o.bind("SUPER + SPACE", "noblerunner launcher", hl.dsp.global("noblerunner:toggle"))
LUA
      ;;
  esac
}

# The choice an existing file holds: one of HOTKEY_KEYS, or "custom".
hotkey_current() {
  local file=$1 binds
  [[ -f $file ]] || { echo off; return; }
  binds=$(grep -vE '^\s*--' "$file" | grep -E '\bbind\(' || true)
  if [[ $(grep -c . <<<"$binds") -ne 1 ]]; then echo custom
  elif [[ $binds == *'"SUPER + SUPER_L"'* ]]; then echo super
  elif [[ $binds == *'"SUPER + SPACE"'* ]]; then echo super-space
  elif [[ $binds == *'"ALT + SPACE"'* ]]; then echo alt-space
  else echo custom
  fi
}

# True when the file is exactly what setup writes for one of the keys, so
# replacing it loses nothing.
hotkey_pristine() {
  local key
  for key in alt-space super super-space; do
    [[ $(cat "$1") == "$(hotkey_lua "$key")" ]] && return 0
  done
  return 1
}

# Guided choice. Prints the chosen key (or "keep") on stdout; the menu goes
# to stderr so the answer can be captured.
hotkey_choose() {
  local file=$1 current=$2 key holder i=0 default=1 answer keep=0
  {
    echo
    echo "Which key should open noblerunner?"
    echo
    for key in "${HOTKEY_KEYS[@]}"; do
      i=$((i + 1))
      # Enter keeps the current key. With no hotkey file yet, it is Alt+Space.
      [[ -f $file && $key == "$current" ]] && default=$i
      printf '  %d) %-12s %s\n' "$i" "$(hotkey_label "$key")" "$(hotkey_note "$key")"
      holder=$(hotkey_holder "$key")
      [[ -n $holder ]] && printf '     %-12s now used by: %s (noblerunner would take it over)\n' "" "$holder"
    done
    if [[ $current == custom ]]; then
      keep=5 default=5
      printf '  5) %-12s leave your own %s as it is\n' "Keep" "$file"
    fi
    echo
    if [[ $current != custom && -f $file ]]; then echo "Current: $(hotkey_label "$current")"; fi
  } >&2
  while true; do
    read -r -p "Choose 1-$(( keep ? 5 : 4 )) [$default]: " answer || { echo >&2; answer=""; }
    answer=${answer:-$default}
    case $answer in
      1|2|3|4) echo "${HOTKEY_KEYS[answer-1]}"; return 0 ;;
      5) (( keep )) && { echo keep; return 0; } ;;
    esac
    echo "Type a number from the list." >&2
  done
}

cmd_setup_hyprland() {
  local assume_yes=0 key="" arg
  for arg in "$@"; do
    case $arg in
      --yes|-y) assume_yes=1 ;;
      --key=*) key=${arg#--key=} ;;
      "") ;;
      *) die "usage: noblerunner setup hyprland [--key=alt-space|super|super-space|off] [--yes]" ;;
    esac
  done
  if [[ -n $key && ! " ${HOTKEY_KEYS[*]} " == *" $key "* ]]; then
    die "unknown key '$key'; use one of: ${HOTKEY_KEYS[*]}"
  fi
  local main="$hypr_dir/hyprland.lua" file="$hypr_dir/noblerunner.lua" legacy="$hypr_dir/$LEGACY_NAME.lua"
  [[ -f $main ]] || die "no $main; this setup targets Lua-configured Hyprland (hyprctl version: $(hyprctl version 2>/dev/null | head -1))"

  # The omacast file moves to the new name first, keeping the user's key.
  if [[ ! -f $file && -f $legacy ]]; then
    # cp -p keeps the old file's mode (it may be private); sed -i keeps it too.
    cp -p -- "$legacy" "$file" &&
      sed -i 's/omacast/noblerunner/g; s/rerunning setup overwrites it/rerunning setup keeps it/' "$file" &&
      rm -- "$legacy" && echo "moved $legacy to $file"
    [[ -n $key ]] || key=keep
  fi

  local current explicit=1 chosen=0
  current=$(hotkey_current "$file")
  if [[ -z $key ]]; then
    if interactive && ! (( assume_yes )); then
      key=$(hotkey_choose "$file" "$current") chosen=1
    elif [[ -f $file ]]; then
      key=keep
    else
      # Nobody picked a key, so nothing may be taken from another bind.
      key=alt-space explicit=0
    fi
  fi

  local holder=""
  [[ $key == keep ]] || holder=$(hotkey_holder "$key")
  if [[ -n $holder ]] && ! (( explicit )); then
    die "Alt+Space is used by: $holder. Pick a key yourself with: noblerunner setup hyprland --key=alt-space|super|super-space|off"
  fi

  local legacy_require=0 has_require=0 plan=() content="" backup="" risky=0
  grep -qE '^\s*require\("hypr\.omacast"\)' "$main" && legacy_require=1
  grep -qE '^\s*require\("hypr\.noblerunner"\)' "$main" && has_require=1
  if [[ $key != keep && $key != off ]]; then content=$(hotkey_lua "$key"); fi
  local replace=0
  if [[ $key != keep && -f $file && $(cat "$file") != "$content" ]]; then
    replace=1
    # A file setup wrote and nobody edited is replaced as it is. Anything
    # else is someone's work: back it up and ask.
    if ! hotkey_pristine "$file"; then
      backup="$file.bak-$(date +%Y%m%d-%H%M%S)"
      risky=1
    fi
  fi

  case $key in
    keep) plan+=("keep your existing $file") ;;
    off)
      if [[ -n $backup ]]; then plan+=("remove the hotkey: move your $file to $backup")
      elif [[ -f $file ]]; then plan+=("remove the hotkey file $file")
      else plan+=("leave the hotkey off (there is no $file)")
      fi
      (( has_require )) && plan+=("remove require(\"hypr.noblerunner\") from $main")
      ;;
    *)
      if [[ -f $file ]] && ! (( replace )); then
        plan+=("keep $file; it already binds $(hotkey_label "$key")")
      else
        [[ -n $backup ]] && plan+=("back up your current $file to $backup")
        plan+=("write $file, binding $(hotkey_label "$key") to the launcher")
      fi
      if [[ -n $holder ]]; then plan+=("take $(hotkey_label "$key") from: $holder"); risky=1; fi
      ;;
  esac
  if [[ $key != off ]]; then
    if (( legacy_require )); then
      plan+=("replace require(\"hypr.omacast\") with require(\"hypr.noblerunner\") in $main")
    elif ! (( has_require )); then
      plan+=("append require(\"hypr.noblerunner\") to $main")
    fi
  fi
  plan+=("reload Hyprland")

  echo "noblerunner setup hyprland will:"
  printf '  - %s\n' "${plan[@]}"
  # Someone who just picked from the menu has already said yes, unless the
  # choice takes a key from something else or replaces a hand-written file.
  if ! (( chosen )) || (( risky )); then
    confirm "Make these changes?" "$assume_yes" || die "nothing changed"
  fi

  if [[ -n $backup ]]; then
    cp -p -- "$file" "$backup" && echo "backed up $file to $backup"
  fi
  case $key in
    keep) ;;
    off)
      if [[ -f $file ]]; then rm -- "$file" && echo "removed $file"; fi
      if (( has_require )); then
        sed -i -E '/^\s*require\("hypr\.noblerunner"\)\s*$/d; /^-- noblerunner launcher bindings$/d' "$main"
        echo "removed the require from $main"
      fi
      ;;
    *)
      if [[ ! -f $file ]] || (( replace )); then
        # Write in place: an existing file keeps its mode.
        printf '%s\n' "$content" >"$file" && echo "wrote $file"
      fi
      [[ $key == super && ! -e $cli_link ]] && link_cli
      ;;
  esac

  if [[ $key != off ]]; then
    if (( legacy_require )); then
      sed -i -E 's/^(\s*)require\("hypr\.omacast"\)/\1require("hypr.noblerunner")/; s/^-- omacast launcher bindings$/-- noblerunner launcher bindings/' "$main"
      echo "updated the require in $main"
    elif ! (( has_require )); then
      printf '\nrequire("hypr.noblerunner")\n' >>"$main"
      echo "added require(\"hypr.noblerunner\") to $main"
    fi
  fi
  if hyprctl reload >/dev/null 2>&1; then
    case $key in
      keep) echo "reloaded Hyprland" ;;
      off) echo "reloaded Hyprland; the hotkey is off. Open the launcher with: noblerunner toggle" ;;
      *) echo "reloaded Hyprland; $(hotkey_label "$key") toggles noblerunner" ;;
    esac
  else
    echo "could not reload Hyprland; run: hyprctl reload" >&2
  fi
}

cmd_doctor() {
  local bad=0
  check() {
    local label=$1; shift
    if "$@" >/dev/null 2>&1; then printf '  ok    %s\n' "$label"; else printf '  FAIL  %s\n' "$label"; bad=1; fi
  }
  echo "noblerunner doctor"
  check "omarchy-shell is installed" command -v omarchy-shell
  check "omarchy-shell is running" omarchy-shell shell ping
  check "socat is installed (fast shell IPC)" command -v socat
  check "Hyprland socket is reachable" hyprctl version
  if managed; then
    printf '  ok    plugin is installed in %s\n' "$repo"
  else
    check "plugin is linked into $plugins_dir" test -n "$(current_link)"
  fi
  check "plugin is enabled" bash -c "omarchy plugin list --json 2>/dev/null | jq -e --arg id '$PLUGIN_ID' 'any(.[]; .id == \$id and .enabled)'"
  check "plugin answers IPC" bash -c "[[ \$(omarchy-shell $IPC_TARGET ping) == ok ]]"
  check "backend answers system.healthPing" bash -c "omarchy-shell $IPC_TARGET call system.healthPing '{}' | grep -q '\"ok\":true'"
  if [[ -x $repo/bin/noblerunner-search ]]; then
    printf '  ok    flea-search helper is built\n'
  else
    printf '  info  no flea-search helper; using the built-in matcher (build it with: noblerunner build-search)\n'
  fi
  local base
  for base in "${XDG_CONFIG_HOME:-$HOME/.config}" "${XDG_DATA_HOME:-$HOME/.local/share}" \
    "${XDG_CACHE_HOME:-$HOME/.cache}" "${XDG_STATE_HOME:-$HOME/.local/state}"; do
    [[ -d $base/$LEGACY_NAME ]] && printf '  info  %s is left from omacast; noblerunner uses %s\n' "$base/$LEGACY_NAME" "$base/noblerunner"
  done
  if [[ -f $hypr_dir/$LEGACY_NAME.lua ]] || grep -qE '^\s*require\("hypr\.omacast"\)' "$hypr_dir/hyprland.lua" 2>/dev/null; then
    printf '  FAIL  the hotkey still uses the old omacast name; run: noblerunner setup hyprland\n'
    bad=1
  elif [[ -f $hypr_dir/noblerunner.lua ]]; then
    printf '  ok    hotkey file %s\n' "$hypr_dir/noblerunner.lua"
  else
    printf '  info  no hotkey yet; run: noblerunner setup hyprland\n'
  fi
  return $bad
}

case "${1:-}" in
  toggle|show|hide) need_shell; ipc "$1" >/dev/null ;;
  run) need_shell; [[ -n ${2:-} ]] || die "usage: noblerunner run <commandId>"; ipc run "$2" ;;
  call) need_shell; [[ -n ${2:-} ]] || die "usage: noblerunner call <method> [json]"; ipc call "$2" "${3:-}" ;;
  ping) need_shell; ipc ping ;;
  build-search) move_legacy_dirs; "$repo/bin/build-search" ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall "${2:-}" ;;
  reload) cmd_reload ;;
  dev) cmd_dev ;;
  setup)
    case "${2:-}" in
      hyprland) cmd_setup_hyprland "${@:3}" ;;
      *) die "usage: noblerunner setup hyprland [--key=alt-space|super|super-space|off] [--yes]" ;;
    esac
    ;;
  doctor) cmd_doctor ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 1 ;;
esac
